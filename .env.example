# Copy to .env and fill in. Never commit .env.

# Leave empty for local development. "prod" switches to PostgreSQL built from DB_* and port 80.
ENV=

# Local database: a SQLite file, no server needed.
# PostgreSQL 15 instead: postgresql+psycopg://<user>:<password>@localhost:5432/health_tech
DATABASE_URL=sqlite:///./health_tech.db

# Used only when ENV=prod.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=health_tech

USER_SERVICE_PORT=8080
AUTH_SERVICE_PORT=8081

# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# "console" prints confirmation emails to the terminal; "smtp" sends them.
MAIL_BACKEND=console
SMTP_USER=
SMTP_PASS=
